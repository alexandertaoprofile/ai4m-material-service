# Service transport
PORT=1116

# A versioned, read-only W-14 reference-case directory.  Do not put this path
# in domain rules; deployment config supplies it instead.
REFERENCE_CASE_ROOT=data/reference_cases/w14_phase_i

# W-14 evidence sources are mounted read-only.  The two directories are
# complementary: MLIP training/model and LAMMPS MD validation respectively.
W14_MLIP_ROOT=
W14_MD_ROOT=

# Set true only after DeepMD/LAMMPS execution, model checksum validation, and
# resource isolation are configured.  The initial service is read-only.
ENABLE_EXECUTION=false
# Optional public origin for Markdown image assets, e.g. https://alpha.example.com
REFRACTORY_ASSET_PUBLIC_BASE_URL=

# Production visual delivery: follows 1111/1115 by publishing PNGs to the
# shared public object-storage prefix.  Keep credentials in the ignored .env.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY_ID=
MINIO_ACCESS_KEY_SECRET=
MINIO_REGION=us-east-1
PICTURE_PUBLIC_BASE_URL=https://www.science42.tech/alpha/materials/modelfiles/image

# Customer-facing Markdown is relayed as an LLM token stream in production.
# Leave blank only for local contract tests; do not commit credentials.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
