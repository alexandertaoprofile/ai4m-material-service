PORT=1105
MATURE_MATERIAL_SERVICE_NAME=mature-material
PROPERTY_DATA_ROOT="/data/se42/backend/property datasets"
MATURE_MATERIAL_RESULTS_ROOT=results/mature_material
# 默认使用本服务 assets/fonts/ 下的中文图表字体；如需覆盖可设置绝对路径。
MATURE_MATERIAL_CJK_FONT_PATH=
MATURE_MATERIAL_CATALOG_ROOT=data/processed
# Object storage uses this service's own local .env; direct MINIO_* variables
# below are canonical.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY_ID=
MINIO_ACCESS_KEY_SECRET=
MINIO_REGION=us-east-1
MINIO_SECURE=true
PICTURE_PUBLIC_BASE_URL=https://www.science42.tech/alpha/materials/modelfiles/image
