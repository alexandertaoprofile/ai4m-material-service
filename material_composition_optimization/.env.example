PORT=1111
ALLOY_RESULTS_ROOT=results/alloy_composition_optimization
# 默认使用本服务 assets/fonts/ 下的中文图表字体；如需覆盖可设置绝对路径。
ALLOY_CJK_FONT_PATH=
ALLOY_MODEL_ROOT=/data/se42/hea_surrogate/models
HEA_SURROGATE_ROOT=/data/se42/hea_surrogate
HEA_SURROGATE_ENV_PREFIX=/data/mamba/envs/mattergen-py310
MAMBA_ROOT_PREFIX=/data/mamba
MICROMAMBA_EXECUTABLE=/home/ubuntu/micromamba
# Optional public HTTP(S) prefix for MaterialsPNG assets. Leave blank to use
# the same host and port as the WebSocket connection.
ALLOY_ASSET_PUBLIC_BASE_URL=
# Object storage: every material service reads these directly from its own
# local .env. Do not commit actual credentials.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY_ID=
MINIO_ACCESS_KEY_SECRET=
MINIO_REGION=us-east-1
MINIO_SECURE=true
PICTURE_PUBLIC_BASE_URL=https://www.science42.tech/alpha/materials/modelfiles/image
ALLOY_PRESENTATION_LLM=true
# Preferred LLM configuration: set real values only in this service's local
# .env.  config/config.yaml remains a legacy compatibility fallback.
ALLOY_PRESENTATION_BASE_URL=
ALLOY_PRESENTATION_API_KEY=
ALLOY_LLM_CONFIG=config/config.yaml
