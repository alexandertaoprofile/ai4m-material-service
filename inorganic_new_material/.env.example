# Web service
PORT=1107
INORGANIC_NEW_MATERIAL_SERVICE_ENV=ai4m-service-py310

# MatterGen and MatterSim run in a separate environment from the web service.
MATTERGEN_ENV_PREFIX=/data/mamba/envs/mattergen-py310
MATTERGEN_DEFAULT_CANDIDATES=1
MATTERGEN_TIMEOUT_SEC=1800
MATTERSIM_ENABLED=true
MATTERSIM_REFERENCE_MODE=mp_api
MATTERSIM_TIMEOUT_SEC=900
PYMATGEN_VALIDATION_TIMEOUT_SEC=120

# Optional LLM constraint completion. Leave secrets only in .env, never here.
NEW_MATERIAL_LLM_ELEMENT_INFERENCE=true
NEW_MATERIAL_LLM_BASE_URL=
NEW_MATERIAL_LLM_API_KEY=
NEW_MATERIAL_LLM_MODEL=SE_V0.0
NEW_MATERIAL_LLM_TIMEOUT_SECONDS=20

# External services and object storage
MP_API_KEY=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY_ID=
MINIO_ACCESS_KEY_SECRET=
PICTURE_PUBLIC_BASE_URL=https://www.science42.tech/alpha/materials/modelfiles/image
GLB_PUBLIC_BASE_URL=https://www.science42.tech/alpha/materials/modelfiles/glb
