# Merge these values into the service-local .env at an approved deployment.
# Preserve existing credentials, object storage, port and popup configuration.
NEW_MATERIAL_GENERATOR=omatg
OMATG_DEFAULT_CANDIDATES=10
OMATG_PYTHON=/data/mamba/envs/omatg-py312/bin/python
OMATG_SOURCE_DIR=/data/third_party/OMatG
OMATG_CHECKPOINT_ROOT=/data/se42/omatg_local/checkpoints
OMATG_RUNTIME_ROOT=/data/se42/omatg_local/runtime
OMATG_GPU_LOCK=/data/se42/omatg_local/runtime/gpu.lock
OMATG_TIMEOUT_SEC=300
OMATG_QUEUE_TIMEOUT_SEC=900
OMATG_RELAX_FMAX=0.05
OMATG_RELAX_MAX_STEPS=500
MATTERSIM_ENABLED=1
MATTERSIM_PYTHON=/data/mamba/envs/mattergen-py310/bin/python
MATTERSIM_ENV_PREFIX=/data/mamba/envs/mattergen-py310
MATTERSIM_CHECKPOINT=/data/se42/omatg_local/checkpoints/mattersim-v1.0.0-1M.pth
MATTERSIM_REFERENCE_CACHE_DIR=/data/mattersim_reference_cache
OMATG_PHASE_DIAGRAM_CACHE_DIR=/data/se42/omatg_local/runtime/phase_diagrams
MATTERSIM_TMPDIR=/data/se42/omatg_local/runtime/tmp
MATTERSIM_TIMEOUT_SEC=900
ALIGNN_ENABLED=1
# Use a NumPy/Torch-compatible interpreter with the existing ALIGNN packages.
ALIGNN_PYTHON=/home/ubuntu/miniconda3/envs/dsc2/bin/python
ALIGNN_SITE_PACKAGES=/data/mamba/envs/alignn-gpu-test/lib/python3.10/site-packages
ALIGNN_CHECKPOINT_ROOT=/data/se42/omatg_local/checkpoints/alignn
ALIGNN_TIMEOUT_SEC=300
