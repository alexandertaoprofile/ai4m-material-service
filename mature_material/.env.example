# deprecated service; direct MINIO_* variables below take precedence.
MINIO_CREDENTIALS_FILE=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY_ID=
MINIO_ACCESS_KEY_SECRET=
MINIO_REGION=us-east-1
MINIO_SECURE=true
PICTURE_PUBLIC_BASE_URL=https://www.science42.tech/alpha/materials/modelfiles/image
