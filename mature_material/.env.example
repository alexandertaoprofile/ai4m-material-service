PORT=1105
MATURE_MATERIAL_SERVICE_NAME=mature-material
PROPERTY_DATA_ROOT="/data/se42/backend/property datasets"
MATURE_MATERIAL_RESULTS_ROOT=results/mature_material
MATURE_MATERIAL_CATALOG_ROOT=data/processed
